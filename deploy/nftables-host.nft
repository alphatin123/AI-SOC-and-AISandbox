table inet aisoc_guard {
    set blocked_v4 {
        type ipv4_addr
        flags timeout
        timeout 15m
        size 1024
    }

    set blocked_v6 {
        type ipv6_addr
        flags timeout
        timeout 15m
        size 1024
    }

    chain protect_host {
        type filter hook input priority -10; policy accept;
        ip saddr 192.168.8.0/24 return
        ip saddr 127.0.0.0/8 return
        ip6 saddr ::1 return
        ip saddr @blocked_v4 counter drop
        ip6 saddr @blocked_v6 counter drop
    }
}